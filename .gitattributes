# Line endings are a property of this project, not of the machine that cloned
# it, and core.autocrlf is a per-machine setting that does not travel with the
# repo. Every text file is LF, in the repository and in every checkout, Windows
# included; the generators in design/ write LF to match.
* text=auto eol=lf

# Binary: never normalise, never diff as text.
*.png  binary
*.pdn  binary

# cmd.exe misreads batch files with LF endings; these stay CRLF everywhere.
*.cmd  text eol=crlf
