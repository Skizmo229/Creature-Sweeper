# Third-party reference material: the original game's client source, kept
# locally for verifying mechanics and deliberately not tracked, because it is
# not our code and this repository is public (README, "Third-party reference").
design/original-reference/

__pycache__/
*.pyc
node_modules/
dist/

# Local, machine-specific harness settings.
.claude/settings.local.json

# OS and editor cruft. A Windows shortcut records the machine it was made on.
.DS_Store
Thumbs.db
*.swp
*.lnk

# Screenshots of the ORIGINAL game and the Paint.NET file they were exported
# from. Third-party expression: hojamaka's, not ours, and so not covered by
# this project's licences. Kept locally to document the original's modes, on
# the same footing as design/original-reference/ above.
game_types.pdn
design/screenshots/

# Zipped builds for itch.io, made by `npm run package`.
release/
